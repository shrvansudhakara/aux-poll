# ====================
# WEBSOCKET SERVER
# ====================

# Port on which the WebSocket server runs
PORT=3001

# Allowed client origin for Socket.IO CORS
CLIENT_URL=http://localhost:3000


# ====================
# INTERNAL COMMUNICATION (WEBSOCKETS)
# ====================

# Secret for authenticating internal requests to the WebSocket server
# Generate with: openssl rand -base64 32
INTERNAL_SECRET=your-internal-secret
