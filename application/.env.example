# ====================
# AUTHENTICATION CORE
# ====================

# Secret used by Better Auth to sign tokens and secure sessions
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-better-auth-secret

# Base URL where your Better Auth server is running
# Development example: http://localhost:3000
# Production example: https://yourdomain.com
BETTER_AUTH_URL=http://localhost:3000

# Public URL exposed to the browser (usually same as BETTER_AUTH_URL)
# Used for client-side authentication flows
NEXT_PUBLIC_APP_URL=http://localhost:3000


# ====================
# OAUTH CONFIGURATION
# ====================

# These credentials allow users to log in using Google or X (Twitter)
# Get them from:
# - Google: https://console.cloud.google.com/apis/credentials
# - X (Twitter): https://developer.x.com/

# ---- Google OAuth ----
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ---- X (Twitter) OAuth ----
TWITTER_CLIENT_ID=your-twitter-client-id
TWITTER_CLIENT_SECRET=your-twitter-client-secret

# ====================
# DATABASE
# ====================

# Neon PostgreSQL connection string
# Get it from: https://console.neon.tech
DATABASE_URL=your-db-url


# ====================
# YOUTUBE DATA API
# ====================

# API key for accessing YouTube Data API v3
# Get your key from: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your-youtube-api-key


# ====================
# INTERNAL COMMUNICATION (WEBSOCKETS)
# ====================

# Secret for authenticating internal requests to the WebSocket server
# Generate with: openssl rand -base64 32
INTERNAL_SECRET=your-internal-secret
